{
  "format_version": "1.26.50",
  "particle_effect": {
    "description": {
      "identifier": "hk:ghost_icon",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/hk/particle/ghost_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.hk_icon = v.hk_icon ?? 0; v.hk_alpha = v.hk_alpha ?? 0.65; v.hk_phase = v.hk_phase ?? 0;"
      },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.6 },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.6 },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [0, "math.sin((v.hk_phase + v.particle_age) * 120) * 0.05", 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.18, 0.18],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 160,
          "texture_height": 60,
          "uv": ["math.mod(v.hk_icon, 8) * 20 + 1", "math.floor(v.hk_icon / 8) * 20 + 1"],
          "uv_size": [18, 18]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "v.hk_alpha * math.clamp(v.particle_age / 0.1, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) / 0.1, 0, 1)"
        ]
      }
    }
  }
}
