        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#texture = '') or (#texture = 'loading'))) and (('%.1s' * #form_button_text) = 'l'))",
        "target_property_name": "#visible"
      }
    ]
  },
  "question@hk_guide.light": {
    "text": "?",
