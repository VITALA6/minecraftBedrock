{
  "namespace": "hk_guide",
  "ink": { "type": "label", "color": [0.23, 0.15, 0.08], "shadow": false, "layer": 6 },
  "light": { "type": "label", "color": [1, 1, 1], "shadow": true, "layer": 9 },
  "name@hk_guide.ink": {
    "text": "#hk_name",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#form_button_text - ('%.3s' * #form_button_text))",
        "target_property_name": "#hk_name"
      }
    ]
  },
  "icon": {
    "type": "image",
    "$icon|default": [16, 16],
    "size": "$icon",
    "layer": 6,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#texture = '') or (#texture = 'loading'))) and (not (('%.1s' * #form_button_text) = 'l')))",
        "target_property_name": "#visible"
      }
    ]
  },
  "silhouette@hk_guide.icon": {
    "color": [0.1, 0.07, 0.05],
    "bindings": [
      {
        "binding_name": "#form_button_texture",
